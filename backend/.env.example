# Used when running the backend directly on the host (uv run uvicorn ...),
# as opposed to via docker-compose (see the root .env.example for that).
# Copy to `.env` and fill in real values. Never commit the real `.env`.

DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=

# 許可するフロントエンドのオリジンをJSON配列文字列で指定する(pydantic-settingsのlist[str]として
# パースされる)。未設定時の既定値は["http://localhost:3000"]。
# 本番では実際のフロントエンドのオリジンに必ず上書きすること(例: ["https://your-frontend-domain.example.com"])。
# Vercel等でデプロイごとにプレビューURLが変わる環境からも許可したい場合、CORSMiddlewareの
# allow_originsは完全一致のみ対応のため、app/main.py側でallow_origin_regexへの切り替えが別途必要になる。
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development
DEBUG=true
