# Used when running the backend directly on the host (uv run uvicorn ...),
# as opposed to via docker-compose (see the root .env.example for that).
# Copy to `.env` and fill in real values. Never commit the real `.env`.

DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=

ENVIRONMENT=development
DEBUG=true
