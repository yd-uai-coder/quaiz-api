# Used by docker-compose.yml / docker-compose.prod.yml.
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- PostgreSQL (container credentials) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Ports exposed on the host (dev only; docker-compose.prod.yml ignores BACKEND_PORT) ---
BACKEND_PORT=8000
NGINX_PORT=80

# --- Backend application settings (passed through to the backend container) ---
# Hostnames "postgres" / "redis" resolve via the docker-compose network.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/app
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=

ENVIRONMENT=development
DEBUG=true
